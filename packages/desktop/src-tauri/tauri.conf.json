{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureWarp",
  "version": "0.1.0",
  "identifier": "com.securewarp.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://securewarp.com",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SecureWarp",
        "url": "https://securewarp.com/drive",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "titleBarStyle": "Visible",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Zero-knowledge encrypted cloud storage",
    "longDescription": "SecureWarp is a zero-knowledge encrypted cloud drive. Files are encrypted in your browser before they ever leave your device."
  }
}
