# Build-time env for production builds.
#
# Next.js inlines NEXT_PUBLIC_* vars into the client bundle during
# `next build`. They MUST be present at build time, not just runtime —
# Cloudflare Worker runtime bindings are not visible to Next.js while
# building.
#
# Only NON-SECRET values belong in this file. Anything sensitive
# (SESSION_SECRET, R2_*, SUPABASE_SERVICE_ROLE_KEY, etc.) goes in
# `wrangler secret put` for runtime and the Cloudflare dashboard
# Builds → Variables panel for build time. Never commit a secret here.

NEXT_PUBLIC_PDF_VIEWER_ORIGIN=https://pdf.securewarp.com
