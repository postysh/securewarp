/**
 * Cloudflare Workers deployment config for SecureWarp.
 *
 * Built via `@opennextjs/cloudflare` — `npm run deploy` runs
 * `opennextjs-cloudflare build && opennextjs-cloudflare deploy`, which
 * emits `.open-next/worker.js` and uploads it using this config.
 *
 * Secrets (SESSION_SECRET, SUPABASE_*, R2_*, TURNSTILE_*, SENTRY_*,
 * CLEANUP_SECRET, CRON_SECRET, RESEND_API_KEY) are set via
 * `wrangler secret put <NAME>`, NOT here — this file is committed to git.
 * Non-secret build-time config (EMAIL_FROM, EMAIL_REPLY_TO) goes under
 * `vars` below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "securewarp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Smart Placement — CF re-homes the Worker to a colo close to the
  // origin DB (Supabase) when the call graph shows that a request
  // waits on far-away subrequests. File bytes never touch the Worker
  // (they go browser → R2 direct via presigned URLs), so this does
  // NOT affect upload/download throughput. It shaves RTT off metadata
  // and auth API calls that the Worker makes to Supabase.
  "placement": { "mode": "smart" },

  // Disable the *.workers.dev preview URL. Traffic should only reach
  // this Worker through the custom domain (securewarp.com). Leaving the
  // workers.dev subdomain enabled is both a backup URL users might
  // accidentally share and an extra origin to keep in CORS/Turnstile.
  "workers_dev": false,
  "preview_urls": false,

  // Static assets emitted by OpenNext build (public/ + Next.js static files).
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },

  // Observability — logs visible via `wrangler tail` and in the Cloudflare
  // dashboard. Sampled at 100% for now; dial down if log volume blows up.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // R2: no Worker binding. We use account-scoped S3-compatible
  // presigned URLs (via aws4fetch in src/lib/db/r2.ts) minted server-side
  // and handed to the browser, which uploads/downloads directly. That
  // model works across multiple buckets (we have 5 shards:
  // securewarp-shard-0..4) without listing each as a binding, and keeps
  // the Worker off the data path entirely. The R2_ACCESS_KEY_ID /
  // R2_SECRET_ACCESS_KEY / R2_ENDPOINT secrets are account-scoped, so
  // they sign URLs for any bucket in the account.

  // Non-secret email config. EMAIL_FROM must match a sender identity
  // verified in Resend (e.g. no-reply@<verified-domain>). RESEND_API_KEY
  // itself is set as a Worker secret via `wrangler secret put RESEND_API_KEY`.
  // Leave these empty here and override per-environment if needed; when
  // RESEND_API_KEY is unset at runtime, src/lib/email/send.ts runs in
  // dev no-op mode.
  // `NEXT_PUBLIC_PDF_VIEWER_ORIGIN` activates the isolated PDF viewer
  // on pdf.securewarp.com. It must be set at BUILD time, not runtime —
  // Next.js inlines NEXT_PUBLIC_* vars into the client bundle during
  // `next build`. If you set it in wrangler but not as a build env,
  // the client won't know about it.
  //
  // Until DNS for pdf.securewarp.com is pointed at this Worker AND
  // the subdomain is added to the custom-domain list in the Cloudflare
  // dashboard, leave this empty. The client falls back gracefully to
  // the same-origin inline PDF iframe, which still works correctly;
  // activating it prematurely just means PDFs fail to preview.
  // Hyperdrive — connection-pooled + edge-cached access to Supabase
  // Postgres. Used by hot read paths (`/api/boot`, `/api/files/list`)
  // via `src/lib/db/pg.ts`. Everything else still goes through
  // @supabase/supabase-js; migration is incremental, not all-or-nothing.
  //
  // Setup (one-time):
  //   1. Grab the DIRECT Postgres connection string from Supabase
  //      (dashboard → Project Settings → Database → Connection string
  //      → **Direct connection**, NOT the pooled ones). Hyperdrive
  //      handles pooling itself.
  //   2. `wrangler hyperdrive create securewarp-prod \
  //        --connection-string="postgresql://postgres:PASSWORD@HOST:5432/postgres"`
  //   3. Paste the returned config id into the `id` field below and
  //      uncomment this block.
  //   4. Redeploy. `hasHyperdrive()` in src/lib/db/pg.ts will start
  //      returning true and hot paths auto-switch from supabase-js
  //      to pg.
  //
  // Until the block below is uncommented, `pg.ts` returns null and
  // every call site falls back to supabase-js — nothing breaks on
  // partially-migrated deploys.
  //
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<paste-hyperdrive-config-id-here>"
  //   }
  // ],

  "vars": {
    "EMAIL_FROM": "SecureWarp <noreply@mail.securewarp.com>",
    // Default Reply-To for every transactional email. Users who hit
    // "Reply" on a welcome or support-ack land in the human support
    // inbox (Fastmail-hosted hello@) instead of bouncing off the
    // noreply@ subdomain which has no MX record. Individual sendEmail
    // calls can override via payload.replyTo — e.g. support-received
    // sets it to the end user's address so hitting reply from the
    // admin inbox goes straight to them.
    "EMAIL_REPLY_TO": "hello@securewarp.com",
    "SUPPORT_INBOX": "hello@securewarp.com",
    "NEXT_PUBLIC_PDF_VIEWER_ORIGIN": "https://pdf.securewarp.com",
    // Stripe publishable key. Public by design — the live key is
    // included in every page load (the client bundle) and is meant
    // to be visible. The matching secret key lives as a Worker
    // secret via `wrangler secret put STRIPE_SECRET_KEY`.
    // Baked into the client bundle at build time via NEXT_PUBLIC_*,
    // so a redeploy is required after rotating the publishable key.
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51TNQK7EHBP1AWE2M4ESihYysqqTHyYgAlLryMiafbi342uO1widHEUlywPxIq9MAhS3HOKLhsrzIHsE1MXIefBx400I7yA3maJ",
  },

  // NOTE on scheduled cleanup: Cloudflare Cron Triggers invoke a Worker's
  // `scheduled()` handler, not an HTTP route, and OpenNext doesn't wire
  // Next.js API routes into that handler. To keep `/api/admin/cleanup-stale`
  // running, either:
  //   (a) hit it from an external scheduler (e.g. another tiny Worker or
  //       cron-job.org) sending `Authorization: Bearer <CLEANUP_SECRET>`; or
  //   (b) add a companion Worker that runs scheduled() and fetches the URL.
  // Not wiring `triggers.crons` here because the default would 404 — the
  // route is at `/api/admin/cleanup-stale`, not at `scheduled()`.
  //
  // NOTE on PDF subdomain: the isolated PDF viewer ships at
  // pdf.securewarp.com. To activate it you need to:
  //   (1) Add `pdf.securewarp.com` as a CNAME in Cloudflare DNS
  //       (or any subdomain record pointing to the Worker).
  //   (2) Add `pdf.securewarp.com` as a custom domain on this Worker
  //       via the Cloudflare dashboard → Workers & Pages → securewarp
  //       → Settings → Domains & Routes.
  //   (3) Set NEXT_PUBLIC_PDF_VIEWER_ORIGIN=https://pdf.securewarp.com
  //       above and redeploy. Rebuild is required — the value is
  //       inlined into the client bundle.
  // Middleware already restricts pdf.securewarp.com to only /viewer;
  // everything else 302s back to www.
}
