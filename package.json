{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "security": "bash scripts/security-scan.sh quick",
    "security:full": "bash scripts/security-scan.sh full",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@marsidev/react-turnstile": "^1.5.0",
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.1",
    "@noble/post-quantum": "^0.6.1",
    "@opennextjs/cloudflare": "^1.19.2",
    "@orama/orama": "^3.1.18",
    "@sentry/nextjs": "^10.48.0",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "argon2-browser": "^1.18.0",
    "aws4fetch": "^1.0.20",
    "bip39": "^3.1.0",
    "dompurify": "^3.4.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.2",
    "mammoth": "^1.12.0",
    "next": "^16.2.4",
    "otpauth": "^9.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "secure-remote-password": "^0.3.1",
    "server-only": "^0.0.1",
    "stripe": "^22.0.2",
    "use-scramble": "^2.2.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "wrangler": "^4.82.2"
  }
}
