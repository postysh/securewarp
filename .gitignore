# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production holds non-secret NEXT_PUBLIC_* build-time vars that
# must be inlined into the client bundle on every build (local + CI).
!.env.production

# cloudflare / opennext
.open-next
.wrangler
cloudflare-env.d.ts

# Tooling / fonts source
.emdash.json
/Chillax Complete/

# typescript
*.tsbuildinfo
next-env.d.ts
